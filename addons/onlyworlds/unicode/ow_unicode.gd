class_name OWUnicode
extends RefCounted
## What the archive's name rules need from Unicode that Godot's String does not have (measured: no normalization,
## no case folding in String's API): NFC, OW-18's fold (NFC, then the C and S rows of CaseFolding 15.1), strict
## UTF-8 decoding, Python's white space for trimming a world id, and the slug of an element's file name (NFKD).
##
## The tables are data in [code]ow_unicode_data.gd[/code], generated by [code]codegen/generate.py[/code].

const D = preload("res://addons/onlyworlds/unicode/ow_unicode_data.gd")

const _SBASE := 0xAC00
const _LBASE := 0x1100
const _VBASE := 0x1161
const _TBASE := 0x11A7
const _LCOUNT := 19
const _VCOUNT := 21
const _TCOUNT := 28
const _NCOUNT := 588     # V * T
const _SCOUNT := 11172   # L * N

static var _white: Dictionary

## Whether every character is ASCII (then NFC is the string itself and the fold is ASCII lowercase).
static func is_ascii(s: String) -> bool:
	return s.to_utf8_buffer().size() == s.length()

## Unicode Normalization Form C.
static func nfc(s: String) -> String:
	if is_ascii(s):
		return s
	return _from_cps(_compose(_decompose(_to_cps(s))))

## OW-18's one fold for every reader: NFC, then simple case folding (the C and S rows).
static func fold(s: String) -> String:
	if is_ascii(s):
		return s.to_lower()      # the only C/S rows that land in ASCII start in ASCII: A-Z
	var cps := _compose(_decompose(_to_cps(s)))
	for i in cps.size():
		cps[i] = D.FOLD.get(cps[i], cps[i])
	return _from_cps(cps)

## [param s] without the white space at its ends, as Python's [code]str.strip()[/code] has it.
static func strip_ws(s: String) -> String:
	if _white.is_empty():
		for cp in D.WHITE_SPACE:
			_white[cp] = true
	var a := 0
	var b := s.length()
	while a < b and _white.has(s.unicode_at(a)):
		a += 1
	while b > a and _white.has(s.unicode_at(b - 1)):
		b -= 1
	return s.substr(a, b - a)

## [param s] without Unicode's White_Space at its ends, the profiles' "trimmed" (the room profile defines it once): a
## narrower set than [method strip_ws]'s, so U+001C to U+001F stay, and so does a byte order mark.
static func trim_white_space(s: String) -> String:
	var a := 0
	var b := s.length()
	while a < b and _is_white_space(s.unicode_at(a)):
		a += 1
	while b > a and _is_white_space(s.unicode_at(b - 1)):
		b -= 1
	return s.substr(a, b - a)

## The profiles' "trimmed and without regard to case" (the room profile defines it once): [method trim_white_space],
## then the C and S rows of CaseFolding 15.1, code point by code point. No NFC: the npm and Python packages' fold.
static func profile_fold(s: String) -> String:
	var t := trim_white_space(s)
	if is_ascii(t):
		return t.to_lower()
	var cps := _to_cps(t)
	for i in cps.size():
		cps[i] = D.FOLD.get(cps[i], cps[i])
	return _from_cps(cps)

## [param text] trimmed and without regard to case, as the profiles define it once: [method profile_fold] under the
## TypeScript SDK's name ([code]trimAndFold[/code], 4.180.0). It trims Unicode's White_Space set at both ends
## (U+0085 and the ideographic space go, a byte order mark and a zero width space stay) and touches nothing inside,
## then applies simple case folding by Unicode 15.1's table (the long s folds to s, the sharp s stays). Neither
## [method String.strip_edges] nor [method String.to_lower] is this. The room, reading-aid, names and charter readers
## match by it. Names as the profiles order them: by [code]trim_and_fold(name)[/code] in [method by_code_point]
## order, ties by id in the same order.
static func trim_and_fold(text: String) -> String:
	return profile_fold(text)

## [param a] and [param b] compared by code point: negative, zero or positive as [param a] sorts before, with or
## after [param b], never by UTF-16 unit (which puts a letter beyond U+FFFF before U+FF5A) and never by a locale's
## collation; when one is a prefix of the other the shorter sorts first. The TypeScript SDK's [code]byCodePoint[/code]
## (4.180.0). A Godot String holds code points and its [code]<[/code] compares them, so this is that order with a
## name, and [method Array.sort] on Strings alone already sorts by it; for [method Array.sort_custom], which wants a
## bool, pass [code]func(x, y): return OWUnicode.by_code_point(x, y) < 0[/code], and chain a tie the same way.
static func by_code_point(a: String, b: String) -> int:
	if a < b:
		return -1
	if b < a:
		return 1
	return 0

## Whether [param c] is a letter of any script or a combining mark (general category L or M, Unicode 15.1): a binary
## search of the generated ranges.
static func is_letter_or_mark(c: int) -> bool:
	var ranges: Array = D.LETTER_OR_MARK
	var lo := 0
	var hi := (ranges.size() >> 1) - 1
	while lo <= hi:
		var mid := (lo + hi) >> 1
		if c < ranges[2 * mid]:
			hi = mid - 1
		elif c > ranges[2 * mid + 1]:
			lo = mid + 1
		else:
			return true
	return false

## The slug of an element's file name (folder spec §3.2): lowercase ASCII kebab of [param text], at most 40
## characters, as the TypeScript and Python packages make it. The name's compatibility decomposition (NFKD, Unicode
## 15.1) with U+0300 to U+036F dropped, so an accented letter is its base letter and a ligature, a full-width letter or
## a Roman numeral its ASCII letters; then every run of anything but a-z and 0-9 is one hyphen, none at either end, and a
## slug longer than 40 is cut to 40 and a hyphen the cut leaves stripped. [code]""[/code] when nothing is left (a name
## of another script only, of punctuation, empty).
static func file_slug(text: String) -> String:
	var out := PackedStringArray()
	var size := 0
	var pending := false
	for i in text.length():
		var c := text.unicode_at(i)
		var piece: String
		if c < 0x80:
			piece = String.chr(c + 32) if c >= 0x41 and c <= 0x5A else String.chr(c)
		else:
			piece = D.SLUG.get(c, "" if c >= 0x300 and c <= 0x36F else "-")
		for j in piece.length():
			var p := piece.unicode_at(j)
			if (p >= 0x61 and p <= 0x7A) or (p >= 0x30 and p <= 0x39):
				if pending and size > 0:
					out.append("-")
					size += 1
				pending = false
				out.append(String.chr(p))
				size += 1
			else:
				pending = true
	var slug := "".join(out)
	if slug.length() > 40:
		slug = slug.substr(0, 40)
		while slug.ends_with("-"):
			slug = slug.substr(0, slug.length() - 1)
	return slug

## Unicode's White_Space property (PropList 15.1): 25 code points.
static func _is_white_space(c: int) -> bool:
	return (c >= 0x09 and c <= 0x0D) or c == 0x20 or c == 0x85 or c == 0xA0 or c == 0x1680 \
		or (c >= 0x2000 and c <= 0x200A) or c == 0x2028 or c == 0x2029 or c == 0x202F or c == 0x205F or c == 0x3000

## Whether [param bytes] are well-formed UTF-8 (no overlong form, no surrogate, nothing past U+10FFFF).
static func is_utf8(bytes: PackedByteArray) -> bool:
	var i := 0
	var n := bytes.size()
	while i < n:
		var b := bytes[i]
		if b < 0x80:
			i += 1
			continue
		var need := 0
		var lo := 0x80
		var hi := 0xBF
		if b >= 0xC2 and b <= 0xDF:
			need = 1
		elif b == 0xE0:
			need = 2; lo = 0xA0
		elif b == 0xED:
			need = 2; hi = 0x9F
		elif b >= 0xE1 and b <= 0xEF:
			need = 2
		elif b == 0xF0:
			need = 3; lo = 0x90
		elif b == 0xF4:
			need = 3; hi = 0x8F
		elif b >= 0xF1 and b <= 0xF3:
			need = 3
		else:
			return false
		if i + need >= n:
			return false          # the sequence runs past the end
		var c1 := bytes[i + 1]
		if c1 < lo or c1 > hi:
			return false
		for j in range(2, need + 1):
			var c := bytes[i + j]
			if c < 0x80 or c > 0xBF:
				return false
		i += need + 1
	return true

## [param bytes] as a String when they are well-formed UTF-8, else [code]null[/code] (never a U+FFFD guess).
static func decode_utf8(bytes: PackedByteArray) -> Variant:
	if not is_utf8(bytes):
		return null
	return bytes.get_string_from_utf8()

# -- NFC ------------------------------------------------------------------------------------------------------------

static func _to_cps(s: String) -> PackedInt32Array:
	var out := PackedInt32Array()
	out.resize(s.length())
	for i in s.length():
		out[i] = s.unicode_at(i)
	return out

static func _from_cps(cps: PackedInt32Array) -> String:
	var parts := PackedStringArray()
	for c in cps:
		parts.append(String.chr(c))
	return "".join(parts)

static func _ccc(c: int) -> int:
	return D.CCC.get(c, 0)

static func _decompose(cps: PackedInt32Array) -> PackedInt32Array:
	var out := PackedInt32Array()
	for c in cps:
		var si := c - _SBASE
		if si >= 0 and si < _SCOUNT:
			out.append(_LBASE + si / _NCOUNT)
			out.append(_VBASE + (si % _NCOUNT) / _TCOUNT)
			var t := si % _TCOUNT
			if t != 0:
				out.append(_TBASE + t)
			continue
		var d = D.DECOMP.get(c)
		if d == null:
			out.append(c)
		else:
			for x in d:
				out.append(x)
	# canonical ordering: a stable sort of each run of non-starters by combining class
	var i := 1
	while i < out.size():
		var cc := _ccc(out[i])
		if cc != 0:
			var j := i
			while j > 0:
				var prev := _ccc(out[j - 1])
				if prev <= cc or prev == 0:
					break
				var tmp := out[j - 1]
				out[j - 1] = out[j]
				out[j] = tmp
				j -= 1
		i += 1
	return out

static func _pair(a: int, b: int) -> int:
	var li := a - _LBASE
	if li >= 0 and li < _LCOUNT:
		var vi := b - _VBASE
		if vi >= 0 and vi < _VCOUNT:
			return _SBASE + (li * _VCOUNT + vi) * _TCOUNT
	var si := a - _SBASE
	if si >= 0 and si < _SCOUNT and si % _TCOUNT == 0:
		var ti := b - _TBASE
		if ti > 0 and ti < _TCOUNT:
			return a + ti
	return D.COMPOSE.get(a << 21 | b, -1)

static func _compose(s: PackedInt32Array) -> PackedInt32Array:
	if s.is_empty():
		return s
	var starter_pos := 0
	var starter := s[0]
	var last_class := _ccc(starter)
	if last_class != 0:
		last_class = 256          # a string that opens with a non-starter: nothing composes onto it
	var comp_pos := 1
	for k in range(1, s.size()):
		var ch := s[k]
		var ch_class := _ccc(ch)
		var composite := _pair(starter, ch)
		if composite != -1 and (last_class < ch_class or last_class == 0):
			s[starter_pos] = composite
			starter = composite
		else:
			if ch_class == 0:
				starter_pos = comp_pos
				starter = ch
			last_class = ch_class
			s[comp_pos] = ch
			comp_pos += 1
	s.resize(comp_pos)
	return s
