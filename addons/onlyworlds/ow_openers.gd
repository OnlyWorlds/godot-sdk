class_name OWOpeners
extends RefCounted
## The Open with menu: the rows that open a world, or one element of it, in a tool, in order, each with the word it
## says when it cannot open now. Pure: a menu draws these rows and decides no word of its own. The rows come from the
## OnlyWorlds tools list (github.com/OnlyWorlds/tools, [code]tools.json[/code] format 1, its README's "Open with"),
## baked into the addon as [constant OWTools.ALL] ([code]ow_tools.gd[/code], generated by
## [code]codegen/generate_tools.py[/code]).
##
## A port of the npm SDK's [code]openersFor[/code] and the Python package's [code]openers_for[/code]: their shared
## fixture, [code]tests/data/openers.fixture.json[/code], is this file's test, so every package gives the same rows.

const WORLD := "world"
const ELEMENT := "element"
const MEMBER := "member"
const PUBLIC := "public"

## The site's own row.
const SITE_ID := "onlyworlds"
const SITE_NAME := "onlyworlds.com"

## The words a row says, sentence case, exactly; "Sign in to <name> first" is [method sign_in_first].
const YOU_ARE_HERE := "You are here"
const NEEDS_A_CONNECTION := "Needs a connection"
## The public's word on a row that needs an account: a signed-out visitor has no seat in the world, so the row opens
## nothing (a menu draws it as it draws a row that needs a connection: disabled, still reachable).
const NEEDS_AN_ACCOUNT := "Needs an account"
const OPENS_IN_YOUR_BROWSER := "Opens in your browser"
const NEEDS_THE_WORLD_ON_THIS_PHONE := "Needs the world on this phone"
const OPENS_THE_WORLD := "Opens the world"

## The keys of a surface, as the fixture and the Python package spell them.
const SURFACE_KEYS := ["tool", "audience", "signed_in", "browser", "phone", "online"]
const _NEEDS := ["account", "device"]
## The keys of the options, the fifth argument.
const OPTION_KEYS := ["element"]
## What an element door may skip ([code]open.element_skips[/code]), the lens profile's graph section's words for what a
## lore view leaves an element out by, in its order: room, hidden, proposed, map space (a Map, Pin or Marker; a Zone is
## content) and a reading aid.
const ELEMENT_MARKS := ["room", "hidden", "proposed", "map_space", "reading_aid"]

## Schemes that open no app: a row whose link used one would run what it carries when pressed.
const _NO_APP := ["javascript", "data", "vbscript", "file", "blob", "about"]

static var _placeholder: RegEx
## A template begins with its scheme (a browser drops leading spaces before reading one).
static var _scheme: RegEx
## A web address: its scheme is http or https, in any case. Read from the row's filled href.
static var _web: RegEx

## What [method openers_for] answers. [member ok] true: [member rows]. False: [member reason], the address profile's
## refusal (one of [constant OWAddress.REFUSALS]), or "" for a caller's mistake that is no refusal, with
## [member message] naming it (the npm SDK's TypeError).
class Result:
	var ok := false
	## Each row a Dictionary [code]{id, name, href, state}[/code]; [code]state[/code] is null when the row opens now and
	## says nothing.
	var rows := []
	var reason := ""
	var message := ""

## "Sign in to <name> first": the word on a row that needs an account, in a browser, signed out.
static func sign_in_first(name: String) -> String:
	return "Sign in to %s first" % name

## The rows of the Open with menu for a world ([param kind] [code]"world"[/code]) or one element of it
## ([code]"element"[/code]), in order: first the site's own row (id [code]onlyworlds[/code], name
## [code]onlyworlds.com[/code], the world's or the element's page on www.onlyworlds.com, for every audience, its one
## word "You are here" when the surface's tool is [code]onlyworlds[/code] (the site itself), else "Needs a connection"
## when offline), then one row per [param tools] row, in the list's order, that is [code]listed[/code] and has a door for
## this kind. [param tools] is [constant OWTools.ALL] or the list as served (its [code]tools[/code] array);
## [param address] is an [OWAddress.Reading] from [method OWAddress.parse_link] or a Dictionary of the parts
## [method OWAddress.element_address_from] takes, with the world's id. A lens and a moment on it ride on no href.
##
## A row with [code]open[/code] null, or with no door for this kind, is not there. On an element, a tool with only a
## world door is a row to its world door that says "Opens the world". On an element given as [param options]'
## [code]element[/code] (the element as served, the mark flat on it), a row whose [code]open.element_skips[/code] names a
## mark the element carries ([constant ELEMENT_MARKS], each read as [method OWGraph.world_graph] reads it) is not there:
## its door cannot open it. A world door alone opens the world, so it stays. Without [code]element[/code] every row is
## there. For the [code]public[/code] audience (the signed-out reader) a row whose [code]open.needs[/code] is
## [code]device[/code] is not there, since a visitor's device holds no world of this one's, and a row whose
## [code]needs[/code] is [code]account[/code] is there and says it needs one.
##
## [param surface] is a Dictionary of what the surface knows, and nothing is guessed: [code]audience[/code]
## ([code]member[/code], a seat in the world, a guest included, or [code]public[/code], the signed-out reader;
## required), [code]signed_in[/code] (true, false, or null or absent when the surface cannot know),
## [code]browser[/code] (false in a game or a desktop app, which cannot see the browser's sign-in; default true),
## [code]phone[/code] (default false), [code]online[/code] (false when the device has no connection; default true) and
## [code]tool[/code] (the client name of the surface's own tool, when it is a listed tool).
##
## Each row's [code]state[/code], the first that holds: "You are here" for the surface's own tool (its
## [code]client[/code] is [code]tool[/code]); then, when [code]online[/code] is false, "Needs a connection" for a row
## whose href is a web address (scheme [code]http:[/code] or [code]https:[/code]; a row whose link opens an app on the
## device is unaffected, and the href stays in the row either way); then, for the [code]public[/code] audience,
## "Needs an account" ([constant NEEDS_AN_ACCOUNT]) for a row whose [code]needs[/code] is [code]account[/code], whatever
## [code]signed_in[/code] says (the href stays in the row; a menu draws it as a row that opens nothing); then what
## [code]needs[/code] asks of this surface: [code]account[/code] outside a browser "Opens in your browser", in a browser signed out "Sign in to <name>
## first" (none when [code]signed_in[/code] is null: a word shows only when the surface knows it is true),
## [code]device[/code] on a phone "Needs the world on this phone"; then "Opens the world" (a world door on an element:
## a sign-in the row needs is the more urgent word); else null.
##
## Refuses ([member Result.reason]) whatever [method OWAddress.element_address] refuses of the whole address, in its own
## form (the site's when it has none): a form, type, id, pairing, moment or lens ([code]bad_moment[/code],
## [code]bad_lens[/code]), and a slug or anything else for the world's id ([code]bad_world[/code]); and an address
## without a world ([code]no_world[/code]), the text form inside a world included.
## [member Result.message] names the rest: a [param kind] that is neither, an element's openers asked of an address
## with no element, an unknown key on the address, the surface or the options, a missing or unknown
## [code]audience[/code], a surface value of the wrong type, an element given for a world's menu or naming another
## element than the address, a tools row that is not one (a [code]needs[/code] or an [code]element_skips[/code] word
## outside the list's format, or skips on a row with no element door, included, and an [code]open[/code] template that
## does not begin with its scheme or whose scheme opens no app: [code]javascript[/code], [code]data[/code],
## [code]vbscript[/code], [code]file[/code], [code]blob[/code] or [code]about[/code], in any case).
static func openers_for(tools: Variant, kind: Variant, address: Variant, surface: Variant, options: Variant = {}) -> Result:
	var out := Result.new()
	if not tools is Array:
		return _mistake(out, "tools is the tools list's rows, an array")
	if not (kind is String or kind is StringName) or (kind != WORLD and kind != ELEMENT):
		return _mistake(out, "kind is 'world' or 'element'; got %s" % _show(kind))
	var a: Dictionary
	if address is OWAddress.Reading:
		a = address.to_dict()
	elif address is Dictionary:
		a = address
	else:
		return _mistake(out, "the address is a Dictionary (form, world, type, id) or a Reading, as parse_link reads it")
	for key in a:
		if not (key is String or key is StringName) or not OWAddress.KEYS.has(String(key)):
			return _mistake(out, "unknown key '%s' in the address. The keys are %s." % [key, ", ".join(OWAddress.KEYS)])
	# The address's checks are the writer's: the whole address in its own form (the site's when it has none), so a
	# bad form, a slug, a bad type, id, moment or lens refuse as there; then the site's page, where a missing world refuses.
	var whole: Dictionary = a.duplicate()
	if whole.get("form") == null:
		whole["form"] = OWAddress.HUMAN
	var checked := OWAddress.element_address_from(whole)
	if not checked.ok:
		out.reason = checked.reason
		out.message = checked.message
		return out
	var page :=OWAddress.element_address(OWAddress.HUMAN, a.get("world"), a.get("type"), a.get("id"))
	if not page.ok:
		out.reason = page.reason
		out.message = page.message
		return out
	var world := str(a["world"]).to_lower()
	var has_element: bool = a.get("type") != null
	if kind == ELEMENT and not has_element:
		return _mistake(out, "an element's openers need an address with its type and id")
	var values := {
		"world": world,
		"type": str(a["type"]) if has_element else "",
		"id": str(a["id"]).to_lower() if has_element else "",
	}

	if not surface is Dictionary:
		return _mistake(out, "the surface is a Dictionary (audience, ...)")
	for key in surface:
		if not (key is String or key is StringName) or not SURFACE_KEYS.has(String(key)):
			return _mistake(out, "unknown key '%s' in the surface. The keys are %s." % [key, ", ".join(SURFACE_KEYS)])
	var tool: Variant = surface.get("tool")
	var audience: Variant = surface.get("audience")
	var signed_in: Variant = surface.get("signed_in")
	var browser: Variant = surface.get("browser", true)
	var phone: Variant = surface.get("phone", false)
	var online: Variant = surface.get("online", true)
	if not (audience is String or audience is StringName) or (audience != MEMBER and audience != PUBLIC):
		return _mistake(out, "surface audience is 'member' or 'public'; got %s" % _show(audience))
	if tool != null and not (tool is String or tool is StringName):
		return _mistake(out, "surface tool is a client name or null")
	if signed_in != null and not signed_in is bool:
		return _mistake(out, "surface signed_in is true, false or null")
	if not browser is bool:
		return _mistake(out, "surface browser is a boolean")
	if not phone is bool:
		return _mistake(out, "surface phone is a boolean")
	if not online is bool:
		return _mistake(out, "surface online is a boolean")

	if not options is Dictionary:
		return _mistake(out, "the options are a Dictionary ({element})")
	for key in options:
		if not (key is String or key is StringName) or not OPTION_KEYS.has(String(key)):
			return _mistake(out, "unknown key '%s' in the options. The keys are %s." % [key, ", ".join(OPTION_KEYS)])
	var element: Variant = options.get("element")
	var marks := []
	if element != null:
		if not element is Dictionary:
			return _mistake(out, "options element is the element as served, a Dictionary, or null")
		if kind != ELEMENT:
			return _mistake(out, "options element is for an element's menu; a world's menu takes none")
		var eid: Variant = element.get("id")
		if not eid is String or eid.to_lower() != values["id"]:
			return _mistake(out, "options element is the element the address names: its id differs")
		marks = marks_of(element)

	var site: String = page.address if kind == ELEMENT else OWAddress.element_address(OWAddress.HUMAN, world).address
	var site_state: Variant = YOU_ARE_HERE if tool == SITE_ID else (NEEDS_A_CONNECTION if _offline(site, online) else null)
	out.rows.append({"id": SITE_ID, "name": SITE_NAME, "href": site, "state": site_state})
	for r in tools:
		if not r is Dictionary or not r.get("id") is String or not r.get("name") is String:
			return _mistake(out, "each tools row is a Dictionary with an id and a name")
		var rid: String = r["id"]
		var name: String = r["name"]
		var o: Variant = r.get("open")
		if o == null:
			continue
		if not o is Dictionary:
			return _mistake(out, "tool %s: open is a Dictionary or null" % rid)
		var world_door: Variant = o.get("world")
		var element_door: Variant = o.get("element")
		var refused := _template_refusal(rid, "world", world_door)
		if refused == "":
			refused = _template_refusal(rid, "element", element_door)
		if refused != "":
			return _mistake(out, refused)
		var needs: Variant = o.get("needs")
		if needs != null and not (needs is String and _NEEDS.has(needs)):
			return _mistake(out, "tool %s: open.needs is 'account', 'device' or null; got %s" % [rid, _show(needs)])
		var skips: Variant = o.get("element_skips")
		if skips == null:
			skips = []
		var words_ok: bool = skips is Array
		if words_ok:
			for s in skips:
				if not (s is String and ELEMENT_MARKS.has(s)):
					words_ok = false
		if not words_ok:
			return _mistake(out, "tool %s: open.element_skips is a list of %s; got %s" % [rid, ", ".join(ELEMENT_MARKS), _show(o.get("element_skips"))])
		if element_door == null and not skips.is_empty():
			return _mistake(out, "tool %s: open.element_skips names what an element door leaves out, and the row has none" % rid)
		var rung: Variant = r.get("rung")
		if not (rung is String and rung == "listed"):
			continue
		if audience == PUBLIC and needs == "device":
			continue
		var template: Variant = world_door if kind == WORLD or element_door == null else element_door
		if template == null:
			continue
		# An element door that cannot open this element is no door (a row with skips has one: refused above).
		if kind == ELEMENT and marks.any(func(m): return skips.has(m)):
			continue
		# The first that holds. A word the row needs (it cannot open now) comes before "Opens the world" (it opens,
		# somewhere else), so a world door alone that needs a sign-in says the sign-in. With no connection a web link
		# opens nothing, whatever else it needs.
		var href := _fill(template, values)
		var client: Variant = r.get("client")
		var state: Variant = null
		if tool != null and client is String and client == String(tool):
			state = YOU_ARE_HERE
		elif _offline(href, online):
			state = NEEDS_A_CONNECTION
		elif audience == PUBLIC and needs == "account":
			state = NEEDS_AN_ACCOUNT
		elif needs == "account" and not browser:
			state = OPENS_IN_YOUR_BROWSER
		elif needs == "account" and signed_in is bool and signed_in == false:
			state = sign_in_first(name)
		elif needs == "device" and phone:
			state = NEEDS_THE_WORLD_ON_THIS_PHONE
		elif kind == ELEMENT and element_door == null:
			state = OPENS_THE_WORLD
		out.rows.append({"id": rid, "name": name, "href": href, "state": state})
	out.ok = true
	return out

## The marks [param element] carries, in [constant ELEMENT_MARKS]' order, each read by the reader
## [method OWGraph.world_graph] uses: [method OWLens._is_room_element], [method OWLens.is_hidden],
## [method OWLens.is_proposed], the type folded among [constant OWGraph.MAP_SPACE], and
## [method OWLens.is_charter_element]. [] for one a lore view keeps.
static func marks_of(element: Dictionary) -> Array:
	var out := []
	if OWLens._is_room_element(element):
		out.append("room")
	if OWLens.is_hidden(element):
		out.append("hidden")
	if OWLens.is_proposed(element):
		out.append("proposed")
	var type: Variant = element.get("type")
	if type is String and OWGraph.MAP_SPACE.has(OWUnicode.profile_fold(type)):
		out.append("map_space")
	if OWLens.is_charter_element(element):
		out.append("reading_aid")
	return out

## What is wrong with one open template, or "" when it is null or a good link: not a string, not beginning with its
## scheme, or a scheme (in any case) that opens no app.
static func _template_refusal(rid: String, key: String, v: Variant) -> String:
	if v == null:
		return ""
	if not v is String:
		return "tool %s: open.%s is a link template or null" % [rid, key]
	if _scheme == null:
		_scheme = RegEx.create_from_string("^([A-Za-z][A-Za-z0-9+.-]*):")
	var m := _scheme.search(v)
	if m == null:
		return "tool %s: open.%s begins with its scheme" % [rid, key]
	var scheme := m.get_string(1).to_lower()
	if _NO_APP.has(scheme):
		return "tool %s: open.%s is a %s: link, which opens no app" % [rid, key, scheme]
	return ""

static func _offline(href: String, online: bool) -> bool:
	if online:
		return false
	if _web == null:
		_web = RegEx.create_from_string("(?i)^https?:")
	return _web.search(href) != null

## Each {world}, {type} and {id} in one pass, as the npm SDK's replace does.
static func _fill(template: String, values: Dictionary) -> String:
	if _placeholder == null:
		_placeholder = RegEx.create_from_string("\\{(world|type|id)\\}")
	var parts := PackedStringArray()
	var at := 0
	for m in _placeholder.search_all(template):
		parts.append(template.substr(at, m.get_start() - at))
		parts.append(values[m.get_string(1)])
		at = m.get_end()
	parts.append(template.substr(at))
	return "".join(parts)

static func _show(v: Variant) -> String:
	return "null" if v == null else JSON.stringify(v)

static func _mistake(out: Result, message: String) -> Result:
	out.ok = false
	out.rows = []
	out.message = "openers_for: " + message
	return out
